{
  "name": "cardano-tessera-dolos",
  "version": "0.0.0",
  "description": "Tessera's verifier inputs read from a Dolos node instead of Koios, and the command that builds that node from Mithril.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./build": {
      "types": "./src/build.ts",
      "import": "./src/build.ts"
    }
  },
  "scripts": {
    "type-check": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "cardano-tessera-client": "workspace:*",
    "cardano-tessera-koios": "workspace:*",
    "cip-179": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
